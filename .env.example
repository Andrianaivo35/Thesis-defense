# =====================================================================
# Modele de configuration — copier en `.env` et completer.
#
# Ce fichier est versionne ; `.env` ne l'est PAS. N'ecrivez jamais de
# mot de passe reel ici.
# =====================================================================

# --- Base de donnees --------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=votre_mot_de_passe_postgres
DB_NAME=stage-share

# DATABASE_URL sert UNIQUEMENT aux migrations Prisma.
# Laissez-la vide : elle est deduite des variables DB_* ci-dessus.
# Ne la renseignez que si la base n'est pas celle des DB_* — ce que fait
# docker-compose, ou l'hote est le nom du service et non localhost.
DATABASE_URL=

# --- Authentification -------------------------------------------------
# OBLIGATOIRE. Sans elle, l'application refuse de demarrer.
# N'importe quelle chaine longue et imprevisible convient. Par exemple :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Fichiers deposes (CV, lettres) -----------------------------------
# Laisser vide hors Docker : le dossier `uploads/` du projet est utilise.
UPLOADS_DIR=

# --- Lecture des CV numerises (OCR) -----------------------------------
# Laisser vide : les donnees linguistiques sont dans `ocr-data/`, livrees
# avec le depot. Aucune connexion n'est requise.
OCR_DATA_DIR=
MOTEUR_OCR=tesseract

# --- Envoi de courriel ------------------------------------------------
# Laisser VIDE pour desactiver proprement l'envoi : l'application
# fonctionne, les courriels sont mis en file et jamais expedies, et les
# liens d'activation sont rendus a l'universite qui les transmet.
#
# Gmail exige un « mot de passe d'application », pas le mot de passe du
# compte.
EMAIL_USER=
EMAIL_PASSWORD=

# Garde-fou. Tant que cette liste est renseignee, AUCUNE autre adresse ne
# peut recevoir de courriel, meme par erreur. Indispensable en essai : le
# jeu de donnees contient des adresses fictives, et une adresse inventee
# peut appartenir a quelqu'un de reel.
COURRIEL_DESTINATAIRES_AUTORISES=

# Adresse publique, utilisee dans les liens des courriels.
APP_URL=http://localhost:3000
git push -u origin v2