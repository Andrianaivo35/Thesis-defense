# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Fichiers televerses par les utilisateurs (CV, lettres) - jamais dans le depot
public/uploads/

# Fichiers televerses (CV, lettres) : volume local pour `npm run dev`.
# Ce sont des donnees personnelles, elles n'ont rien a faire dans le depot.
/uploads/

# Artefacts de reprise sur un autre poste : ils contiennent des CV, donc
# des donnees personnelles, et se transmettent hors du depot.
# La procedure, elle, est versionnee : export/INSTALLATION.md.
/export/*
!/export/INSTALLATION.md

# Chapitre 3 : figures et document engendres par scripts/memoire/.
# Ils se regenerent en trois commandes, et pesent plusieurs Mo.
/chapitre3/
